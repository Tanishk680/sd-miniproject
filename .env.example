# Copy to .env and fill in real values. Never commit .env.
# Shared JWT secret (gateway + user-service + order-service must match).
# Backend services read it ONLY from here; the gateway prefers
# AWS_JWT_SECRET_ID when set (proving the Secrets Manager path on EC2).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2h

# AWS Secrets Manager (EC2 path): single JSON secret, e.g.
# prod/ecommerce/app = {"JWT_SECRET": "...", "GATEWAY_ADMIN_TOKEN": "...", "MONGO_ROOT_PASSWORD": "..."}
# The instance IAM role supplies credentials (no keys here).
# AWS_JWT_SECRET_ID=arn:aws:secretsmanager:us-east-1:358545164930:secret:prod/ecommerce/app-XXXXXX
# AWS_REGION=us-east-1

# CloudWatch custom metrics from the gateway (0 = off/local, 1 = on).
# Requires cloudwatch:PutMetricData on the instance role; logs flow via the
# awslogs driver regardless of this flag.
# AWS_CLOUDWATCH_METRICS=0

# Gateway admin endpoints (/gateway/status|metrics|reload).
# Required in production; optional locally (warn-only when unset).
GATEWAY_ADMIN_TOKEN=change-me-admin-token

# Comma-separated allowed browser origins for CORS
CORS_ORIGIN=http://localhost:3000

# MongoDB root credentials (production compose file only; dev uses no-auth local Mongo)
MONGO_ROOT_USERNAME=appadmin
MONGO_ROOT_PASSWORD=change-me-mongo-password-url-safe

# development | production (production enables fail-closed secrets/admin)
NODE_ENV=development
