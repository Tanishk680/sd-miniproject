# Copy to .env and fill in real values. Never commit .env.
# Shared JWT secret (gateway + user-service + order-service must match)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2h

# Gateway admin endpoints (/gateway/status|metrics|reload).
# Required in production; optional locally (warn-only when unset).
GATEWAY_ADMIN_TOKEN=change-me-admin-token

# Comma-separated allowed browser origins for CORS
CORS_ORIGIN=http://localhost:3000

# MongoDB root credentials (production compose file only; dev uses no-auth local Mongo)
MONGO_ROOT_USERNAME=appadmin
MONGO_ROOT_PASSWORD=change-me-mongo-password-url-safe

# development | production (production enables fail-closed secrets/admin)
NODE_ENV=development
