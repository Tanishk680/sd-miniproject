[Unit]
Description=Live twin control API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sim/server
ExecStart=/usr/bin/node src/server.js
EnvironmentFile=/etc/sim/.env
Restart=always
RestartSec=5
User=sim
Group=sim
# SQLite file and run summaries live under /var/lib/sim
ReadWritePaths=/var/lib/sim
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
