PROMETHEUS_URL=http://127.0.0.1:9090
MOCK_MODE=0
SIM_DB=/var/lib/sim/twin.sqlite
SNAPSHOT_INTERVAL_MS=1000
MAX_RUN_MS=360000
K6_BIN=k6
EC2_HOST=
