GATEWAY_RATE_LIMIT_RPS=83

SIM_PUBLIC_SCENARIO_ACCESS=1
SIM_ADMIN_IDENTITIES=name=token,name2=token2
SIM_RUN_LIMIT_PER_WINDOW=15
SIM_RUN_LIMIT_WINDOW_MS=60000
SIM_CHAOS_LIMIT_PER_WINDOW=30
SIM_CHAOS_LIMIT_WINDOW_MS=60000
SIM_TRUST_PROXY=0

