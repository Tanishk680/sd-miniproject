{
  "info": {
    "name": "E-Commerce Microservices",
    "description": "Full e2e flow: register → login → browse → order → history + gateway admin"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.code === 201);",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"testuser\",\"email\":\"test@example.com\",\"password\":\"secret123\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/register", "host": ["{{baseUrl}}"], "path": ["api", "users", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.code === 200);",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"testuser\",\"password\":\"secret123\"}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/login", "host": ["{{baseUrl}}"], "path": ["api", "users", "login"] }
          }
        },
        {
          "name": "Profile (no token → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('401', () => pm.response.code === 401);"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          }
        },
        {
          "name": "Profile (with token → 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200', () => pm.response.code === 200);"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List all",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200 with 12 products', () => { pm.response.code === 200 && pm.response.json().products.length === 12; });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        },
        {
          "name": "Filter by category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products?category=Electronics", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "category", "value": "Electronics" }] }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/search?q=keyboard", "host": ["{{baseUrl}}"], "path": ["api", "products", "search"], "query": [{ "key": "q", "value": "keyboard" }] }
          }
        },
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "products", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.code === 201);",
                  "pm.environment.set('orderId', pm.response.json().order._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"items\":[{\"productId\":\"PRODUCT_ID_HERE\",\"name\":\"Test Product\",\"price\":9.99,\"quantity\":1}]}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "List orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200', () => pm.response.code === 200);"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Get order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          }
        }
      ]
    },
    {
      "name": "Gateway Admin",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/gateway/status", "host": ["{{baseUrl}}"], "path": ["gateway", "status"] }
          }
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/gateway/metrics", "host": ["{{baseUrl}}"], "path": ["gateway", "metrics"] }
          }
        },
        {
          "name": "Reload config",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/gateway/reload", "host": ["{{baseUrl}}"], "path": ["gateway", "reload"] }
          }
        }
      ]
    }
  ]
}